@model EmployeeAvailVM

<div class="card shadow border-0 my-4">
    <div class="card-header bg-primary bg-gradient ml-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h4 class="text-white py-2"> @(Model.EmployeeAvailability.AvailID != 0 ? "Update" : "Add") Employee Availability</h4>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        <form method="post" class="row" enctype="multipart/form-data">
            <input asp-for="EmployeeAvailability.AvailID" hidden />
            <div class="row">
                <div class="col-12">
                    <div class="border p-3">
                        @*<div asp-validation-summary="ModelOnly"></div>*@
                        <div class="py-2 col-12">
                            <label asp-for="EmployeeAvailability.EmpID" class="form-label fw-semibold"></label>

                            <select asp-for="EmployeeAvailability.EmpID"
                                    asp-items="@Model.EmployeeList"
                                    class="form-select border-0 shadow"
                                    id="employeeDropdown">
                                <option value="">--Select Employee--</option>
                            </select>

                            <span asp-validation-for="EmployeeAvailability.EmpID" class="text-danger"></span>
                        </div>

                        <div class="py-2 col-12 col-md-6">
                            <label asp-for="EmployeeAvailability.AvailDate" class="form-label fw-semibold"></label>

                            <input asp-for="EmployeeAvailability.AvailDate"
                                   type="date"
                                   value="@Model.EmployeeAvailability.AvailDate.ToString("yyyy-MM-dd")"
                                   class="form-control shadow" />

                            <span asp-validation-for="EmployeeAvailability.AvailDate" class="text-danger"></span>
                        </div>
                       
                        <div class="form-check py-3">
                            <input asp-for="EmployeeAvailability.Avail" class="form-check-input" type="checkbox" />
                            <label asp-for="EmployeeAvailability.Avail" class="form-check-label"></label>
                            <span asp-validation-for="EmployeeAvailability.Avail" class="text-danger d-block"></span>
                        </div>

                    
                        
                        <div class="row pt-2">
                            <div class="col-6 col-md-3">
                                @if (Model.EmployeeAvailability.AvailID != 0)
                                {
                                    <button type="submit" class="btn btn-primary form-control">Update</button>
                                }
                                else
                                {
                                    <button type="submit" class="btn btn-primary form-control">Add</button>
                                }
                            </div>
                            <div class="col-6 col-md-3">
                                <a asp-controller="EmployeeAvailability" asp-action="Index" class="btn btn-outline-primary border  form-control">
                                    Back to List
                                </a>
                            </div>
                        </div>


                    </div>
                </div>

            </div>

        </form>
    </div>
</div>




@section Scripts {

    @{
        <partial name="_ValidationScriptsPartial" />
    }
         
    <script>
        $(document).ready(function () {
            $('#employeeDropdown').select2({
                placeholder: "--Select Employee--",
                allowClear: true,
                width: '100%'
            });
        });
    </script>

}