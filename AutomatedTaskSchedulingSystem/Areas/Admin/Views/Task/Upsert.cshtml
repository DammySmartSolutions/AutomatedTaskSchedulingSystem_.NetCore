@model TaskVM

<div class="card shadow border-0 my-4">
    <div class="card-header bg-primary bg-gradient ml-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h4 class="text-white py-2"> @(Model.Tasks.TaskID != 0 ? "Update" : "Create") Task</h4>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        <form method="post" class="row" enctype="multipart/form-data">
            <input asp-for="Tasks.TaskID" hidden />
            <div class="row">
                <div class="col-12">
                    <div class="border p-3">
                        @*<div asp-validation-summary="ModelOnly"></div>*@
                        <div class="form-floating py-2 col-12">
                            <input asp-for="Tasks.TaskName" class="form-control border-0 shadow" placeholder="Task Name" />
                            <label asp-for="Tasks.TaskName" class="ms-2"></label>
                            <span asp-validation-for="Tasks.TaskName" class="text-danger"></span>
                        </div>

                        <div class="form-floating py-2 col-12">
                            <select asp-for="@Model.Tasks.LocId" asp-items="@Model.LocationList" class="form-select border-0 shadow">
                                <option disabled selected>--Select Location--</option>
                            </select>
                            <label asp-for="Tasks.LocId" class="ms-2"></label>
                            <span asp-validation-for="Tasks.LocId" class="text-danger"></span>
                        </div>

                        <div class="form-floating py-2 col-12">
                            <input asp-for="Tasks.MinEmployees" class="form-control border-0 shadow" placeholder="Min No. of Employees that can be assigned" />
                            <label asp-for="Tasks.MinEmployees" class="ms-2"></label>
                            <span asp-validation-for="Tasks.MinEmployees" class="text-danger"></span>
                        </div>
                        <div class="form-floating py-2 col-12">
                            <input asp-for="Tasks.MaxEmployees" class="form-control border-0 shadow" placeholder="Max No. of Employees that can be assigned" />
                            <label asp-for="Tasks.MaxEmployees" class="ms-2"></label>
                            <span asp-validation-for="Tasks.MaxEmployees" class="text-danger"></span>
                        </div>

                        
                        <div class="row pt-2">
                            <div class="col-6 col-md-3">
                                @if (Model.Tasks.TaskID != 0)
                                {
                                    <button type="submit" class="btn btn-primary form-control">Update</button>
                                }
                                else
                                {
                                    <button type="submit" class="btn btn-primary form-control">Create</button>
                                }
                            </div>
                            <div class="col-6 col-md-3">
                                <a asp-controller="Task" asp-action="Index" class="btn btn-outline-primary border  form-control">
                                    Back to List
                                </a>
                            </div>
                        </div>


                    </div>
                </div>

            </div>

        </form>
    </div>
</div>




@section Scripts {

    @{
        <partial name="_ValidationScriptsPartial" />
    }
}