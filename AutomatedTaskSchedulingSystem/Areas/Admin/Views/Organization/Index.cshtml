@model List<SetupOrganization>

@{
    ViewData["Title"] = "Organization List";
}

<div class="container-fluid px-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mt-4 mb-4">
        <div>
            <h4 class="text-primary mb-1">
                Organization List
            </h4>
           
        </div>

        <div>
            <a asp-area="Admin"
               asp-controller="Organization"
               asp-action="Upsert"
               class="btn btn-primary">
                <i class="bi bi-plus-circle me-1"></i>
                Create New Organization
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0">
           <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0" id="tblData">
                    <thead class="table-light">
                        <tr>
                            <th>Org ID</th>
                            <th>Name</th>
                            <th>Address</th>
                            <th>Telephone</th>
                            <th class="text-center" style="width: 100px;">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                       
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>


@section Scripts{

    <script src="~/js/Organization.js"></script>
}